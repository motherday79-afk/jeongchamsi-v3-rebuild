[{"start": 0, "duration": 3.2321541950113377, "text": "기사님 일과도 관련된 정책이 있어요."}, {"start": 3.412154195011338, "duration": 8.913151927437642, "text": "제가 주재한 중소기업 현장대화에서 정부는 지역별 택시자격증을 전국 단위로 통합하는 방안을 내놨어요."}, {"start": 12.50530612244898, "duration": 4.668231292517007, "text": "지역마다 따로 발급받는 불편을 줄이자는 내용이었죠."}, {"start": 17.353537414965984, "duration": 5.56421768707483, "text": "택시의 모든 영업구역 제한까지 없애자는 말과는 구분해야 해요."}, {"start": 23.097755102040814, "duration": 4.231904761904762, "text": "자격증 체계의 통합을 다룬 개선과제였으니까요."}, {"start": 27.509659863945576, "duration": 8.065238095238096, "text": "제가 혼자 법안을 발의했다는 뜻은 아니고, 관계부처가 마련해 그 자리에서 발표한 정책이에요."}, {"start": 35.75489795918367, "duration": 4.993968253968254, "text": "현장에서 겪는 행정절차의 불편을 줄이자는 방향이었죠."}]