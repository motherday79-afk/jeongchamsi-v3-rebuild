[{"start": 0, "duration": 2.1786848072562357, "text": "안녕하세요, 기사님."}, {"start": 2.358684807256236, "duration": 3.4231065759637187, "text": "오늘도 운전하시느라 고생이 많으세요."}, {"start": 5.961791383219955, "duration": 3.904512471655329, "text": "잠깐이라도 쉬어 가며 일하셨으면 좋겠네요."}, {"start": 10.046303854875283, "duration": 6.0829705215419505, "text": "제가 나누고 싶은 이야기가 있는데, 괜찮으시면 한번 들어주시겠습니까?"}]