[{"start": 0, "duration": 3.5801587301587303, "text": "제 이야기를 차분히 들어주셔서 고맙네요."}, {"start": 3.7601587301587305, "duration": 4.726802721088435, "text": "조금 더 함께하고 싶으시면 계속 듣기를 눌러 주세요."}, {"start": 8.666961451247165, "duration": 2.3508163265306123, "text": "다음 생각도 들려드릴게요."}, {"start": 11.197777777777777, "duration": 6.032199546485261, "text": "기사님 생각과 다르거나 별로라고 느끼셨다면 내려주기를 눌러 주세요."}, {"start": 17.40997732426304, "duration": 2.19297052154195, "text": "부담 갖지 않으셔도 돼요."}]