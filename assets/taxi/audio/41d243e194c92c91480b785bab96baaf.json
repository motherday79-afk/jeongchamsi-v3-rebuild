[{"start": 0, "duration": 3.1898866213151926, "text": "여기까지 들어주셔서 고맙습니다, 기사님."}, {"start": 3.369886621315193, "duration": 4.533537414965987, "text": "제 이야기가 괜찮으셨다면 계속 듣기로 다음 이야기를 들어 주세요."}, {"start": 8.08342403628118, "duration": 3.24546485260771, "text": "아직 판단이 안 서셔도 더 들어보실 수 있어요."}, {"start": 11.50888888888889, "duration": 4.445487528344671, "text": "생각이 다르거나 그만 듣고 싶으시면 내려주기를 눌러 주세요."}]