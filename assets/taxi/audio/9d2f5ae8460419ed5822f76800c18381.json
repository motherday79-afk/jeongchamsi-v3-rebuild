[{"start": 0, "duration": 2.1163265306122447, "text": "안녕하세요, 기사님."}, {"start": 2.296326530612245, "duration": 7.059569160997732, "text": "오늘은 한 사람을 대신하는 것이 아니라, 한 정당의 정책 이야기를 들려드리러 탔어요."}, {"start": 9.535895691609976, "duration": 3.60297052154195, "text": "어느 정당인지는 내릴 때 말씀드릴게요."}, {"start": 13.318866213151926, "duration": 7.37546485260771, "text": "가는 동안 다섯 가지 이야기를 나누고, 다른 정당의 생각도 함께 살펴보면 어떨까요?"}, {"start": 20.874331065759634, "duration": 4.3778231292517, "text": "이름보다는 내용에 마음이 가는 쪽을 골라 주세요."}, {"start": 25.432154195011336, "duration": 3.876984126984127, "text": "괜찮으시면 제 이야기를 한번 들어주시겠습니까?"}]