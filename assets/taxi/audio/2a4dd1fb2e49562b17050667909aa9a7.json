[{"start": 0, "duration": 3.854671201814059, "text": "여기까지 들어주셔서 고맙습니다, 기사님."}, {"start": 4.034671201814059, "duration": 5.718480725623583, "text": "제 이야기에 동의하셨다면 공감하기를 눌러 마음을 남겨 주세요."}, {"start": 9.933151927437642, "duration": 4.573650793650794, "text": "공감하기는 다음 이야기로 넘어가는 버튼은 아니에요."}, {"start": 14.686802721088435, "duration": 7.446167800453515, "text": "조금 더 들어보고 싶으시면 계속 듣기를, 그만 듣고 싶으시면 내려주기를 눌러 주세요."}, {"start": 22.31297052154195, "duration": 2.5756689342403627, "text": "천천히 생각하셔도 좋아요."}, {"start": 25.06863945578231, "duration": 3.4100680272108845, "text": "저는 기사님의 선택을 존중하니까요."}]