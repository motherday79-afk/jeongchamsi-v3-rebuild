[{"start": 0, "duration": 3.734172335600907, "text": "여기까지 들어주셔서 고맙습니다, 기사님."}, {"start": 3.9141723356009073, "duration": 5.476417233560091, "text": "제 이야기가 괜찮으셨다면 계속 듣기로 다음 이야기를 들어 주세요."}, {"start": 9.570589569160997, "duration": 3.836575963718821, "text": "아직 판단이 안 서셔도 더 들어보실 수 있어요."}, {"start": 13.587165532879819, "duration": 5.347074829931973, "text": "생각이 다르거나 그만 듣고 싶으시면 내려주기를 눌러 주세요."}]