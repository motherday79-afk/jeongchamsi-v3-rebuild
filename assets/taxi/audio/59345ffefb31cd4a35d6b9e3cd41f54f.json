[{"start": 0, "duration": 2.4396145124716555, "text": "기사님은 어떻게 생각하세요?"}, {"start": 2.6196145124716557, "duration": 6.563922902494331, "text": "제 의견이 마음에 드셨거나 다음 이야기가 궁금하시면 계속 듣기를 눌러 주세요."}, {"start": 9.363537414965986, "duration": 6.189024943310658, "text": "다른 생각이 드시거나 더 듣고 싶지 않으시면 내려주기를 눌러 주셔도 됩니다."}, {"start": 15.732562358276644, "duration": 2.059705215419501, "text": "편하게 선택해 주세요."}]