[{"start": 0, "duration": 2.1210884353741495, "text": "안녕하세요, 기사님."}, {"start": 2.3010884353741496, "duration": 3.317641723356009, "text": "오늘도 운전하시느라 고생이 많으세요."}, {"start": 5.798730158730159, "duration": 3.78390022675737, "text": "잠깐이라도 쉬어 가며 일하셨으면 좋겠네요."}, {"start": 9.76263038548753, "duration": 5.89843537414966, "text": "제가 나누고 싶은 이야기가 있는데, 괜찮으시면 한번 들어주시겠습니까?"}]