[{"start": 0, "duration": 3.348798185941043, "text": "제 이야기를 차분히 들어주셔서 고맙네요."}, {"start": 3.528798185941043, "duration": 4.26108843537415, "text": "마음이 닿는 부분이 있었다면 공감하기를 눌러 주세요."}, {"start": 7.969886621315193, "duration": 6.974308390022676, "text": "공감은 마음을 남기는 선택이고, 다음 이야기로 가시려면 계속 듣기를 눌러 주시면 돼요."}, {"start": 15.124195011337868, "duration": 5.4759863945578235, "text": "여기까지만 함께하고 싶으시면 내려주기를 선택하셔도 괜찮습니다."}, {"start": 20.78018140589569, "duration": 2.085124716553288, "text": "부담 갖지 않으셔도 돼요."}, {"start": 23.045306122448977, "duration": 3.0936281179138323, "text": "저는 기사님의 선택을 존중하니까요."}]