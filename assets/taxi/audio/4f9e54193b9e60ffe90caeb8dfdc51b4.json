[{"start": 0, "duration": 3.0522675736961453, "text": "제 이야기를 차분히 들어주셔서 고맙네요."}, {"start": 3.2322675736961455, "duration": 3.7994331065759637, "text": "마음이 닿는 부분이 있었다면 공감하기를 눌러 주세요."}, {"start": 7.211700680272109, "duration": 6.093310657596372, "text": "공감은 마음을 남기는 선택이고, 다음 이야기로 가시려면 계속 듣기를 눌러 주시면 돼요."}, {"start": 13.485011337868482, "duration": 4.8106575963718825, "text": "여기까지만 함께하고 싶으시면 내려주기를 선택하셔도 괜찮습니다."}, {"start": 18.475668934240364, "duration": 1.9702040816326531, "text": "부담 갖지 않으셔도 돼요."}, {"start": 20.62587301587302, "duration": 2.8403174603174604, "text": "저는 기사님의 선택을 존중하니까요."}]