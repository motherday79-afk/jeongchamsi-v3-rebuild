[{"start": 0, "duration": 2.728027210884354, "text": "기사님, 제 생각은 어떠셨어요?"}, {"start": 2.908027210884354, "duration": 5.808117913832199, "text": "마음에 드셨거나 조금 더 들어보고 싶으시면 계속 듣기를 눌러 주세요."}, {"start": 8.896145124716554, "duration": 2.4672562358276644, "text": "다음 이야기도 나누고 싶네요."}, {"start": 11.54340136054422, "duration": 5.753446712018141, "text": "생각이 다르거나 여기까지만 듣고 싶으시면 내려주기를 눌러 주세요."}, {"start": 17.476848072562362, "duration": 2.3517233560090705, "text": "어떤 선택이든 괜찮습니다."}]