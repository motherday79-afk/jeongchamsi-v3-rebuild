[{"start": 0, "duration": 2.0852154195011336, "text": "안녕하세요, 기사님."}, {"start": 2.265215419501134, "duration": 3.236485260770975, "text": "오늘도 운전하시느라 고생이 많으세요."}, {"start": 5.681700680272109, "duration": 3.6900680272108843, "text": "잠깐이라도 쉬어 가며 일하셨으면 좋겠네요."}, {"start": 9.551768707482994, "duration": 5.767868480725624, "text": "제가 나누고 싶은 이야기가 있는데, 괜찮으시면 한번 들어주시겠습니까?"}]