[{"start": 0, "duration": 2.339591836734694, "text": "기사님은 어떻게 생각하세요?"}, {"start": 2.519591836734694, "duration": 6.2870521541950115, "text": "제 의견이 마음에 드셨거나 다음 이야기가 궁금하시면 계속 듣기를 눌러 주세요."}, {"start": 8.986643990929705, "duration": 5.928072562358277, "text": "다른 생각이 드시거나 더 듣고 싶지 않으시면 내려주기를 눌러 주셔도 됩니다."}, {"start": 15.09471655328798, "duration": 2.0119727891156463, "text": "편하게 선택해 주세요."}]