[{"start": 0, "duration": 3.4998185941043083, "text": "여기까지 들어주셔서 고맙습니다, 기사님."}, {"start": 3.6798185941043084, "duration": 5.122358276643991, "text": "제 이야기가 괜찮으셨다면 계속 듣기로 다음 이야기를 들어 주세요."}, {"start": 8.9821768707483, "duration": 3.587845804988662, "text": "아직 판단이 안 서셔도 더 들어보실 수 있어요."}, {"start": 12.750022675736961, "duration": 5.0059410430839, "text": "생각이 다르거나 그만 듣고 싶으시면 내려주기를 눌러 주세요."}]