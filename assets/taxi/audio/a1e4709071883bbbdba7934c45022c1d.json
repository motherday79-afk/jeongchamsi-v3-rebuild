[{"start": 0.1, "duration": 4.8216835, "text": "기사님, 제 얘기 들어주셔서 고맙습니다."}, {"start": 5.011683, "duration": 3.7762754, "text": "꼭 같은 생각이실 필요는 없어요."}, {"start": 8.927959, "duration": 3.6982142, "text": "아직 잘 모르겠으셔도 괜찮고요."}, {"start": 12.766173, "duration": 4.4770407, "text": "천천히 생각해 보시고, 편하게 선택해 주세요."}]