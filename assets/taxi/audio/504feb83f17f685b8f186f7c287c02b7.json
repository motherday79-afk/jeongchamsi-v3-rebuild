[{"start": 0, "duration": 2.190861678004535, "text": "기사님은 어떻게 생각하세요?"}, {"start": 2.3708616780045353, "duration": 5.536439909297052, "text": "제 의견이 마음에 드셨거나 다음 이야기가 궁금하시면 계속 듣기를 눌러 주세요."}, {"start": 8.087301587301587, "duration": 5.206984126984127, "text": "다른 생각이 드시거나 더 듣고 싶지 않으시면 내려주기를 눌러 주셔도 됩니다."}, {"start": 13.474285714285713, "duration": 1.8998639455782314, "text": "편하게 선택해 주세요."}]