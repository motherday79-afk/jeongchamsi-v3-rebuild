[{"start": 0, "duration": 2.0852154195011336, "text": "안녕하세요, 기사님."}, {"start": 2.265215419501134, "duration": 1.4771655328798186, "text": "반갑습니다."}, {"start": 3.9223809523809523, "duration": 2.702018140589569, "text": "오늘은 손님을 많이 만나셨나요?"}, {"start": 6.804399092970522, "duration": 2.3553514739229024, "text": "서두르지 않으셔도 괜찮아요."}, {"start": 9.339750566893425, "duration": 5.554489795918367, "text": "가는 동안 제가 하고 싶은 이야기가 있는데, 잠깐 들어주시겠습니까?"}]