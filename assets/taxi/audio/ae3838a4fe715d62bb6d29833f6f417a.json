[{"start": 0, "duration": 2.0566666666666666, "text": "안녕하세요, 기사님."}, {"start": 2.236666666666667, "duration": 1.4535147392290249, "text": "반갑습니다."}, {"start": 3.870181405895692, "duration": 2.592607709750567, "text": "오늘은 손님을 많이 만나셨나요?"}, {"start": 6.642789115646259, "duration": 2.287120181405896, "text": "서두르지 않으셔도 괜찮아요."}, {"start": 9.109909297052155, "duration": 5.321156462585034, "text": "가는 동안 제가 하고 싶은 이야기가 있는데, 잠깐 들어주시겠습니까?"}]