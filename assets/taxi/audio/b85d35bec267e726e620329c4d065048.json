[{"start": 0, "duration": 3.6451020408163264, "text": "여기까지 들어주셔서 고맙습니다, 기사님."}, {"start": 3.8251020408163265, "duration": 5.417324263038549, "text": "제 이야기에 동의하셨다면 공감하기를 눌러 마음을 남겨 주세요."}, {"start": 9.422426303854875, "duration": 4.331269841269841, "text": "공감하기는 다음 이야기로 넘어가는 버튼은 아니에요."}, {"start": 13.933696145124717, "duration": 7.067369614512471, "text": "조금 더 들어보고 싶으시면 계속 듣기를, 그만 듣고 싶으시면 내려주기를 눌러 주세요."}, {"start": 21.18106575963719, "duration": 2.4350113378684806, "text": "천천히 생각하셔도 좋아요."}, {"start": 23.79607709750567, "duration": 3.224172335600907, "text": "저는 기사님의 선택을 존중하니까요."}]