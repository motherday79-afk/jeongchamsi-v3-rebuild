[{"start": 0, "duration": 2.1786848072562357, "text": "안녕하세요, 기사님."}, {"start": 2.358684807256236, "duration": 1.5514512471655328, "text": "반갑습니다."}, {"start": 4.090136054421769, "duration": 2.857732426303855, "text": "오늘은 손님을 많이 만나셨나요?"}, {"start": 7.127868480725624, "duration": 2.490907029478458, "text": "서두르지 않으셔도 괜찮아요."}, {"start": 9.798775510204083, "duration": 5.860294784580499, "text": "가는 동안 제가 하고 싶은 이야기가 있는데, 잠깐 들어주시겠습니까?"}]