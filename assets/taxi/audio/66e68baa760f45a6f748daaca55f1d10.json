[{"start": 0, "duration": 3.1898866213151926, "text": "여기까지 들어주셔서 고맙습니다, 기사님."}, {"start": 3.369886621315193, "duration": 4.591904761904762, "text": "제 이야기에 동의하셨다면 공감하기를 눌러 마음을 남겨 주세요."}, {"start": 8.141791383219955, "duration": 3.7078684807256237, "text": "공감하기는 다음 이야기로 넘어가는 버튼은 아니에요."}, {"start": 12.029659863945579, "duration": 5.918730158730159, "text": "조금 더 들어보고 싶으시면 계속 듣기를, 그만 듣고 싶으시면 내려주기를 눌러 주세요."}, {"start": 18.128390022675738, "duration": 2.192312925170068, "text": "천천히 생각하셔도 좋아요."}, {"start": 20.500702947845806, "duration": 2.8403174603174604, "text": "저는 기사님의 선택을 존중하니까요."}]