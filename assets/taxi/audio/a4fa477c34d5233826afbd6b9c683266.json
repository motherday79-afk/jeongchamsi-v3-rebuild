[{"start": 0, "duration": 3.6962585034013604, "text": "제 이야기를 차분히 들어주셔서 고맙네요."}, {"start": 3.8762585034013606, "duration": 4.698571428571428, "text": "마음이 닿는 부분이 있었다면 공감하기를 눌러 주세요."}, {"start": 8.75482993197279, "duration": 7.672312925170068, "text": "공감은 마음을 남기는 선택이고, 다음 이야기로 가시려면 계속 듣기를 눌러 주시면 돼요."}, {"start": 16.607142857142858, "duration": 6.026530612244898, "text": "여기까지만 함께하고 싶으시면 내려주기를 선택하셔도 괜찮습니다."}, {"start": 22.813673469387755, "duration": 2.2647392290249435, "text": "부담 갖지 않으셔도 돼요."}, {"start": 25.258412698412698, "duration": 3.4100680272108845, "text": "저는 기사님의 선택을 존중하니까요."}]