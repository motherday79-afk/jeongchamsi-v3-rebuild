[{"start": 0, "duration": 3.582403628117914, "text": "제 이야기를 차분히 들어주셔서 고맙네요."}, {"start": 3.762403628117914, "duration": 4.724195011337868, "text": "조금 더 함께하고 싶으시면 계속 듣기를 눌러 주세요."}, {"start": 8.666598639455781, "duration": 2.3543990929705214, "text": "다음 생각도 들려드릴게요."}, {"start": 11.200997732426302, "duration": 6.028208616780045, "text": "기사님 생각과 다르거나 별로라고 느끼셨다면 내려주기를 눌러 주세요."}, {"start": 17.409206349206347, "duration": 2.196326530612245, "text": "부담 갖지 않으셔도 돼요."}]