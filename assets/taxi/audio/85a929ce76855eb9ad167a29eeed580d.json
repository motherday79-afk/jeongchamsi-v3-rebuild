[{"start": 0, "duration": 2.580249433106576, "text": "기사님은 어떻게 생각하세요?"}, {"start": 2.7602494331065763, "duration": 6.917369614512472, "text": "제 의견이 마음에 드셨거나 다음 이야기가 궁금하시면 계속 듣기를 눌러 주세요."}, {"start": 9.857619047619048, "duration": 6.522789115646258, "text": "다른 생각이 드시거나 더 듣고 싶지 않으시면 내려주기를 눌러 주셔도 됩니다."}, {"start": 16.560408163265308, "duration": 2.17875283446712, "text": "편하게 선택해 주세요."}]