[{"start": 0, "duration": 3.0522675736961453, "text": "제 이야기를 차분히 들어주셔서 고맙네요."}, {"start": 3.2322675736961455, "duration": 3.930884353741497, "text": "조금 더 함께하고 싶으시면 계속 듣기를 눌러 주세요."}, {"start": 7.343151927437642, "duration": 2.0815873015873017, "text": "다음 생각도 들려드릴게요."}, {"start": 9.604739229024943, "duration": 4.963718820861678, "text": "기사님 생각과 다르거나 별로라고 느끼셨다면 내려주기를 눌러 주세요."}, {"start": 14.748458049886622, "duration": 1.9702040816326531, "text": "부담 갖지 않으셔도 돼요."}]