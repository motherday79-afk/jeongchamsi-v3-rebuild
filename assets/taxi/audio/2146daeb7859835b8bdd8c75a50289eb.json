[{"start": 0, "duration": 2.0566666666666666, "text": "안녕하세요, 기사님."}, {"start": 2.236666666666667, "duration": 3.1132879818594104, "text": "오늘도 운전하시느라 고생이 많으세요."}, {"start": 5.529954648526077, "duration": 3.5319274376417233, "text": "잠깐이라도 쉬어 가며 일하셨으면 좋겠네요."}, {"start": 9.2418820861678, "duration": 5.52562358276644, "text": "제가 나누고 싶은 이야기가 있는데, 괜찮으시면 한번 들어주시겠습니까?"}]