[{"start": 0, "duration": 3.4943083900226757, "text": "제 이야기를 차분히 들어주셔서 고맙네요."}, {"start": 3.674308390022676, "duration": 4.614240362811791, "text": "조금 더 함께하고 싶으시면 계속 듣기를 눌러 주세요."}, {"start": 8.468548752834467, "duration": 2.295668934240363, "text": "다음 생각도 들려드릴게요."}, {"start": 10.94421768707483, "duration": 5.897596371882086, "text": "기사님 생각과 다르거나 별로라고 느끼셨다면 내려주기를 눌러 주세요."}, {"start": 17.021814058956913, "duration": 2.1414739229024944, "text": "부담 갖지 않으셔도 돼요."}]