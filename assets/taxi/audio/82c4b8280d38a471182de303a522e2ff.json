[{"start": 0, "duration": 3.5801587301587303, "text": "제 이야기를 차분히 들어주셔서 고맙네요."}, {"start": 3.7601587301587305, "duration": 4.558979591836735, "text": "마음이 닿는 부분이 있었다면 공감하기를 눌러 주세요."}, {"start": 8.499138321995465, "duration": 7.4459410430839, "text": "공감은 마음을 남기는 선택이고, 다음 이야기로 가시려면 계속 듣기를 눌러 주시면 돼요."}, {"start": 16.125079365079365, "duration": 5.8474829931972785, "text": "여기까지만 함께하고 싶으시면 내려주기를 선택하셔도 괜찮습니다."}, {"start": 22.152562358276644, "duration": 2.19297052154195, "text": "부담 갖지 않으셔도 돼요."}, {"start": 24.525532879818595, "duration": 3.302947845804989, "text": "저는 기사님의 선택을 존중하니까요."}]