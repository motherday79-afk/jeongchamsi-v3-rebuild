[{"start": 0, "duration": 3.7365079365079366, "text": "여기까지 들어주셔서 고맙습니다, 기사님."}, {"start": 3.9165079365079367, "duration": 5.473333333333334, "text": "제 이야기가 괜찮으셨다면 계속 듣기로 다음 이야기를 들어 주세요."}, {"start": 9.56984126984127, "duration": 3.8390022675736963, "text": "아직 판단이 안 서셔도 더 들어보실 수 있어요."}, {"start": 13.588843537414967, "duration": 5.3440589569161, "text": "생각이 다르거나 그만 듣고 싶으시면 내려주기를 눌러 주세요."}]