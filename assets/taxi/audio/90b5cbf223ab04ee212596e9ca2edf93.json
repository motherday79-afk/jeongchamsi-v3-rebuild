[{"start": 0, "duration": 1.9467573696145124, "text": "안녕하세요, 기사님."}, {"start": 2.1267573696145123, "duration": 1.3790022675736961, "text": "반갑습니다."}, {"start": 3.6857596371882084, "duration": 2.4161451247165533, "text": "오늘은 손님을 많이 만나셨나요?"}, {"start": 6.281904761904762, "duration": 2.1531065759637187, "text": "서두르지 않으셔도 괜찮아요."}, {"start": 8.61501133786848, "duration": 4.690408163265306, "text": "가는 동안 제가 하고 싶은 이야기가 있는데, 잠깐 들어주시겠습니까?"}]