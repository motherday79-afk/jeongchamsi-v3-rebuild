[{"start": 0, "duration": 3.4998185941043083, "text": "여기까지 들어주셔서 고맙습니다, 기사님."}, {"start": 3.6798185941043084, "duration": 5.1899773242630385, "text": "제 이야기에 동의하셨다면 공감하기를 눌러 마음을 남겨 주세요."}, {"start": 9.049795918367346, "duration": 4.145804988662132, "text": "공감하기는 다음 이야기로 넘어가는 버튼은 아니에요."}, {"start": 13.375600907029478, "duration": 6.76859410430839, "text": "조금 더 들어보고 싶으시면 계속 듣기를, 그만 듣고 싶으시면 내려주기를 눌러 주세요."}, {"start": 20.324195011337867, "duration": 2.3361224489795918, "text": "천천히 생각하셔도 좋아요."}, {"start": 22.840317460317458, "duration": 3.0936281179138323, "text": "저는 기사님의 선택을 존중하니까요."}]