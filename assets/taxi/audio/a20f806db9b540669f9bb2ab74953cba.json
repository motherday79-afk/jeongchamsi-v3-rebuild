[{"start": 0, "duration": 3.348798185941043, "text": "제 이야기를 차분히 들어주셔서 고맙네요."}, {"start": 3.528798185941043, "duration": 4.420612244897959, "text": "조금 더 함께하고 싶으시면 계속 듣기를 눌러 주세요."}, {"start": 8.129410430839002, "duration": 2.2116780045351474, "text": "다음 생각도 들려드릴게요."}, {"start": 10.52108843537415, "duration": 5.6492517006802725, "text": "기사님 생각과 다르거나 별로라고 느끼셨다면 내려주기를 눌러 주세요."}, {"start": 16.35034013605442, "duration": 2.085124716553288, "text": "부담 갖지 않으셔도 돼요."}]