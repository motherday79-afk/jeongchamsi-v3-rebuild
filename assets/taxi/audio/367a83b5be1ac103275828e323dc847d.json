[{"start": 0, "duration": 2.0852154195011336, "text": "안녕하세요, 기사님."}, {"start": 2.265215419501134, "duration": 2.791156462585034, "text": "이른 시간부터 운행하고 계시네요."}, {"start": 5.236371882086168, "duration": 1.9490702947845806, "text": "식사는 챙겨 드셨어요?"}, {"start": 7.365442176870749, "duration": 3.30421768707483, "text": "오늘도 편안한 하루가 되셨으면 좋겠어요."}, {"start": 10.849659863945579, "duration": 4.842471655328798, "text": "제가 나누고 싶은 이야기가 있는데, 한번 들어주시겠습니까?"}]