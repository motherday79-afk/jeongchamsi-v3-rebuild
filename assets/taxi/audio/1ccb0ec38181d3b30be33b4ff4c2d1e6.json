[{"start": 0, "duration": 3.6451020408163264, "text": "여기까지 들어주셔서 고맙습니다, 기사님."}, {"start": 3.8251020408163265, "duration": 5.346689342403628, "text": "제 이야기가 괜찮으셨다면 계속 듣기로 다음 이야기를 들어 주세요."}, {"start": 9.351791383219954, "duration": 3.744081632653061, "text": "아직 판단이 안 서셔도 더 들어보실 수 있어요."}, {"start": 13.275873015873016, "duration": 5.225260770975057, "text": "생각이 다르거나 그만 듣고 싶으시면 내려주기를 눌러 주세요."}]