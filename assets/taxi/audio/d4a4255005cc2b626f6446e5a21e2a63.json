[{"start": 0, "duration": 3.582403628117914, "text": "제 이야기를 차분히 들어주셔서 고맙네요."}, {"start": 3.762403628117914, "duration": 4.556530612244898, "text": "마음이 닿는 부분이 있었다면 공감하기를 눌러 주세요."}, {"start": 8.49893424036281, "duration": 7.440544217687075, "text": "공감은 마음을 남기는 선택이고, 다음 이야기로 가시려면 계속 듣기를 눌러 주시면 돼요."}, {"start": 16.119478458049883, "duration": 5.843718820861678, "text": "여기까지만 함께하고 싶으시면 내려주기를 선택하셔도 괜찮습니다."}, {"start": 22.14319727891156, "duration": 2.196326530612245, "text": "부담 갖지 않으셔도 돼요."}, {"start": 24.519523809523808, "duration": 3.305034013605442, "text": "저는 기사님의 선택을 존중하니까요."}]