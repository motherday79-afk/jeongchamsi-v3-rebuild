[{"start": 0, "duration": 2.1163265306122447, "text": "안녕하세요, 기사님."}, {"start": 2.296326530612245, "duration": 3.3155555555555556, "text": "오늘도 운전하시느라 고생이 많으세요."}, {"start": 5.791882086167801, "duration": 3.7813151927437643, "text": "잠깐이라도 쉬어 가며 일하셨으면 좋겠네요."}, {"start": 9.753197278911566, "duration": 5.901768707482993, "text": "제가 나누고 싶은 이야기가 있는데, 괜찮으시면 한번 들어주시겠습니까?"}]