[{"start": 0, "duration": 3.7365079365079366, "text": "여기까지 들어주셔서 고맙습니다, 기사님."}, {"start": 3.9165079365079367, "duration": 5.545034013605442, "text": "제 이야기에 동의하셨다면 공감하기를 눌러 마음을 남겨 주세요."}, {"start": 9.641541950113378, "duration": 4.4354195011337865, "text": "공감하기는 다음 이야기로 넘어가는 버튼은 아니에요."}, {"start": 14.256961451247165, "duration": 7.221224489795919, "text": "조금 더 들어보고 싶으시면 계속 듣기를, 그만 듣고 싶으시면 내려주기를 눌러 주세요."}, {"start": 21.658185941043083, "duration": 2.4969614512471656, "text": "천천히 생각하셔도 좋아요."}, {"start": 24.33514739229025, "duration": 3.305034013605442, "text": "저는 기사님의 선택을 존중하니까요."}]