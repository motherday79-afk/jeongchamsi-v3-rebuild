[{"start": 0, "duration": 3.4943083900226757, "text": "제 이야기를 차분히 들어주셔서 고맙네요."}, {"start": 3.674308390022676, "duration": 4.449591836734694, "text": "마음이 닿는 부분이 있었다면 공감하기를 눌러 주세요."}, {"start": 8.303900226757369, "duration": 7.282176870748299, "text": "공감은 마음을 남기는 선택이고, 다음 이야기로 가시려면 계속 듣기를 눌러 주시면 돼요."}, {"start": 15.766077097505669, "duration": 5.716621315192744, "text": "여기까지만 함께하고 싶으시면 내려주기를 선택하셔도 괜찮습니다."}, {"start": 21.66269841269841, "duration": 2.1414739229024944, "text": "부담 갖지 않으셔도 돼요."}, {"start": 23.984172335600906, "duration": 3.224172335600907, "text": "저는 기사님의 선택을 존중하니까요."}]