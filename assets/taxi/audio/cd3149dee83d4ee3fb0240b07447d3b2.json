[{"start": 0, "duration": 2.1210884353741495, "text": "안녕하세요, 기사님."}, {"start": 2.3010884353741496, "duration": 1.5068934240362812, "text": "반갑습니다."}, {"start": 3.987981859410431, "duration": 2.769795918367347, "text": "오늘은 손님을 많이 만나셨나요?"}, {"start": 6.937777777777778, "duration": 2.414988662131519, "text": "서두르지 않으셔도 괜찮아요."}, {"start": 9.532766439909297, "duration": 5.68249433106576, "text": "가는 동안 제가 하고 싶은 이야기가 있는데, 잠깐 들어주시겠습니까?"}]