[{"start": 0, "duration": 3.854671201814059, "text": "여기까지 들어주셔서 고맙습니다, 기사님."}, {"start": 4.034671201814059, "duration": 5.644784580498866, "text": "제 이야기가 괜찮으셨다면 계속 듣기로 다음 이야기를 들어 주세요."}, {"start": 9.859455782312924, "duration": 3.9610204081632654, "text": "아직 판단이 안 서셔도 더 들어보실 수 있어요."}, {"start": 14.000476190476189, "duration": 5.510430839002267, "text": "생각이 다르거나 그만 듣고 싶으시면 내려주기를 눌러 주세요."}]