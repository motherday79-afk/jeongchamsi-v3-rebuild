[{"start": 0.1, "duration": 4.1591835, "text": "기사님, 제 얘기 들어주셔서 고맙습니다."}, {"start": 4.349183, "duration": 3.137755, "text": "꼭 같은 생각이실 필요는 없어요."}, {"start": 7.626939, "duration": 3.3673468, "text": "아직 잘 모르겠으셔도 괜찮고요."}, {"start": 11.134286, "duration": 4.2219386, "text": "천천히 생각해 보시고, 편하게 선택해 주세요."}]