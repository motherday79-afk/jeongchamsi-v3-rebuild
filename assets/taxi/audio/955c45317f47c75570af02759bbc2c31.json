[{"start": 0, "duration": 3.6962585034013604, "text": "제 이야기를 차분히 들어주셔서 고맙네요."}, {"start": 3.8762585034013606, "duration": 4.872063492063492, "text": "조금 더 함께하고 싶으시면 계속 듣기를 눌러 주세요."}, {"start": 8.928321995464852, "duration": 2.4278231292517005, "text": "다음 생각도 들려드릴게요."}, {"start": 11.536145124716553, "duration": 6.216802721088436, "text": "기사님 생각과 다르거나 별로라고 느끼셨다면 내려주기를 눌러 주세요."}, {"start": 17.93294784580499, "duration": 2.2647392290249435, "text": "부담 갖지 않으셔도 돼요."}]