[{"start": 0, "duration": 2.50140589569161, "text": "기사님은 어떻게 생각하세요?"}, {"start": 2.68140589569161, "duration": 6.7076870748299315, "text": "제 의견이 마음에 드셨거나 다음 이야기가 궁금하시면 계속 듣기를 눌러 주세요."}, {"start": 9.569092970521542, "duration": 6.324943310657597, "text": "다른 생각이 드시거나 더 듣고 싶지 않으시면 내려주기를 눌러 주셔도 됩니다."}, {"start": 16.07403628117914, "duration": 2.112607709750567, "text": "편하게 선택해 주세요."}]