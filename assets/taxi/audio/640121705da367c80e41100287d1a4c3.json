[{"start": 0, "duration": 3.734172335600907, "text": "여기까지 들어주셔서 고맙습니다, 기사님."}, {"start": 3.9141723356009073, "duration": 5.548140589569161, "text": "제 이야기에 동의하셨다면 공감하기를 눌러 마음을 남겨 주세요."}, {"start": 9.642312925170067, "duration": 4.437823129251701, "text": "공감하기는 다음 이야기로 넘어가는 버튼은 아니에요."}, {"start": 14.260136054421768, "duration": 7.226485260770975, "text": "조금 더 들어보고 싶으시면 계속 듣기를, 그만 듣고 싶으시면 내려주기를 눌러 주세요."}, {"start": 21.666621315192742, "duration": 2.4936054421768707, "text": "천천히 생각하셔도 좋아요."}, {"start": 24.340226757369614, "duration": 3.302947845804989, "text": "저는 기사님의 선택을 존중하니까요."}]