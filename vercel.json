{
  "regions": [
    "icn1"
  ],
  "git": {
    "deploymentEnabled": {
      "codex/poll-data": false
    }
  },
  "functions": {
    "api/gateway.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs"
    },
    "api/share.js": {
      "maxDuration": 10
    },
    "api/human-poll-cron.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs"
    },
    "api/push-worker.js": {
      "maxDuration": 120,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "completion-push"
        }
      ]
    },
    "api/now-rank-cron.js": {
      "maxDuration": 60
    },
    "api/update-watchdog-cron.js": {
      "maxDuration": 60
    },
    "api/now-rank-worker.js": {
      "maxDuration": 60,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "now-rank-refresh"
        }
      ]
    }
  },
  "crons": [
    {
      "path": "/api/update-watchdog-cron",
      "schedule": "15 9 * * *"
    },
    {
      "path": "/api/now-rank-cron",
      "schedule": "53 6 * * *"
    },
    {
      "path": "/api/human-poll-cron",
      "schedule": "0 8 * * 1,4,5"
    }
  ],
  "rewrites": [
    {
      "source": "/political-map/:path*",
      "destination": "/api/share?path=political-map/:path*"
    },
    {
      "source": "/notifications",
      "destination": "/notifications.html"
    },
    {
      "source": "/sw.js",
      "destination": "/sw.js"
    },
    {
      "source": "/manifest.webmanifest",
      "destination": "/manifest.webmanifest"
    },
    {
      "source": "/mine",
      "destination": "/taxi/index.html"
    },
    {
      "source": "/mine/ad",
      "destination": "/taxi/index.html"
    },
    {
      "source": "/api/v3/:path*",
      "destination": "/api/gateway?path=:path*"
    },
    {
      "source": "/person/:path*",
      "destination": "/api/share?path=person/:path*"
    },
    {
      "source": "/column/:path*",
      "destination": "/api/share?path=column/:path*"
    },
    {
      "source": "/news/:path*",
      "destination": "/api/share?path=news/:path*"
    },
    {
      "source": "/itsme/:path*",
      "destination": "/api/share?path=itsme/:path*"
    },
    {
      "source": "/community/:path*",
      "destination": "/api/share?path=community/:path*"
    },
    {
      "source": "/poll/:path*",
      "destination": "/api/share?path=poll/:path*"
    },
    {
      "source": "/generation-president/:path*",
      "destination": "/api/share?path=generation-president/:path*"
    },
    {
      "source": "/president/:path*",
      "destination": "/api/share?path=president/:path*"
    },
    {
      "source": "/compare",
      "destination": "/api/share?path=compare"
    },
    {
      "source": "/political-comic/:path*",
      "destination": "/api/share?path=political-comic/:path*"
    },
    {
      "source": "/ai-panel/:path*",
      "destination": "/api/share?path=ai-panel/:path*"
    },
    {
      "source": "/now/:path*",
      "destination": "/api/share?path=now/:path*"
    },
    {
      "source": "/shop/:path*",
      "destination": "/api/share?path=shop/:path*"
    },
    {
      "source": "/groups/:path*",
      "destination": "/api/share?path=groups/:path*"
    },
    {
      "source": "/campaigns/:path*",
      "destination": "/api/share?path=campaigns/:path*"
    },
    {
      "source": "/points/:path*",
      "destination": "/api/share?path=points/:path*"
    },
    {
      "source": "/support/:path*",
      "destination": "/api/share?path=support/:path*"
    },
    {
      "source": "/about/:path*",
      "destination": "/api/share?path=about/:path*"
    },
    {
      "source": "/mock-bill/:path*",
      "destination": "/api/share?path=mock-bill/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/polimable/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/polimarble/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/academy/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/national-evaluation/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/keywords/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/territory/:path*",
      "destination": "/mine",
      "permanent": false
    },
    {
      "source": "/lib/taxi-passengers.js",
      "destination": "/mine",
      "permanent": false
    }
  ]
}
