{
  "regions": ["icn1"],
  "git": {"deploymentEnabled": {"codex/poll-data": false}},
  "functions": {
    "api/gateway.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs"
    },
    "api/share.js": {
      "maxDuration": 10
    },
    "api/human-poll-cron.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs"
    },
    "api/push-worker.js": {
      "maxDuration": 60,
      "experimentalTriggers": [{"type":"queue/v2beta","topic":"completion-push"}]
    },
    "api/now-rank-cron.js": {
      "maxDuration": 60
    },
    "api/update-watchdog-cron.js": {"maxDuration":60},
    "api/now-rank-worker.js": {
      "maxDuration": 60,
      "experimentalTriggers": [{"type":"queue/v2beta","topic":"now-rank-refresh"}]
    }
  },
  "crons": [
    {"path":"/api/update-watchdog-cron","schedule":"15 9 * * *"},
    {
      "path": "/api/now-rank-cron",
      "schedule": "53 6 * * *"
    },
    {
      "path": "/api/human-poll-cron",
      "schedule": "0 8 * * 1,4,5"
    }
  ],
  "rewrites": [
    {
      "source": "/mine",
      "destination": "/mine/index.html"
    },
    {
      "source": "/mine/ad",
      "destination": "/mine/index.html"
    },
    {
      "source": "/api/v3/:path*",
      "destination": "/api/gateway?path=:path*"
    },
    {
      "source": "/person/:path*",
      "destination": "/api/share?path=person/:path*"
    },
    {
      "source": "/column/:path*",
      "destination": "/api/share?path=column/:path*"
    },
    {
      "source": "/news/:path*",
      "destination": "/api/share?path=news/:path*"
    },
    {
      "source": "/itsme/:path*",
      "destination": "/api/share?path=itsme/:path*"
    },
    {
      "source": "/community/:path*",
      "destination": "/api/share?path=community/:path*"
    },
    {
      "source": "/academy/:path*",
      "destination": "/api/share?path=academy/:path*"
    },
    {
      "source": "/poll/:path*",
      "destination": "/api/share?path=poll/:path*"
    },
    {
      "source": "/national-evaluation/:path*",
      "destination": "/api/share?path=national-evaluation/:path*"
    },
    {
      "source": "/generation-president/:path*",
      "destination": "/api/share?path=generation-president/:path*"
    },
    {
      "source": "/president/:path*",
      "destination": "/api/share?path=president/:path*"
    },
    {
      "source": "/compare",
      "destination": "/api/share?path=compare"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/polimable/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/polimarble/:path*",
      "destination": "/",
      "permanent": false
    }
  ]
}
